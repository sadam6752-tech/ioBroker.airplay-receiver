{
    "i18n": true,
    "type": "tabs",
    "items": {
        "_speakersTab": {
            "type": "panel",
            "label": "Speakers",
            "items": {
                "_speakersHelp": {
                    "type": "staticText",
                    "text": "One row per AirPlay speaker: the name on the iPhone and the state that plays a URL. Satellites of ioBroker.assistant and Dune HD fill stop, volume, title and stream by themselves; set a field to override it, or - for none.",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "receivers": {
                    "type": "table",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "items": [
                        {
                            "type": "checkbox",
                            "attr": "enabled",
                            "title": "Active",
                            "width": "5%",
                            "default": true
                        },
                        {
                            "type": "text",
                            "attr": "name",
                            "title": "AirPlay name",
                            "width": "11%",
                            "default": ""
                        },
                        {
                            "type": "autocompleteSendTo",
                            "attr": "urlState",
                            "title": "Play URL state",
                            "width": "24%",
                            "command": "listUrlStates",
                            "freeSolo": true,
                            "default": ""
                        },
                        {
                            "type": "select",
                            "attr": "stream",
                            "title": "Stream",
                            "width": "11%",
                            "default": "auto",
                            "noTranslation": true,
                            "options": [
                                {
                                    "label": "Auto",
                                    "value": "auto"
                                },
                                {
                                    "label": "FLAC 48 kHz mono",
                                    "value": "flac/48000/1"
                                },
                                {
                                    "label": "FLAC 48 kHz stereo",
                                    "value": "flac/48000/2"
                                },
                                {
                                    "label": "FLAC 44.1 kHz stereo",
                                    "value": "flac/44100/2"
                                },
                                {
                                    "label": "MP3 48 kHz mono",
                                    "value": "mp3/48000/1"
                                },
                                {
                                    "label": "MP3 48 kHz stereo",
                                    "value": "mp3/48000/2"
                                },
                                {
                                    "label": "MP3 44.1 kHz stereo",
                                    "value": "mp3/44100/2"
                                }
                            ]
                        },
                        {
                            "type": "text",
                            "attr": "stopState",
                            "title": "Stop state",
                            "width": "13%",
                            "default": ""
                        },
                        {
                            "type": "text",
                            "attr": "stopValue",
                            "title": "Stop value",
                            "width": "7%",
                            "default": ""
                        },
                        {
                            "type": "text",
                            "attr": "volumeState",
                            "title": "Volume state",
                            "width": "12%",
                            "default": ""
                        },
                        {
                            "type": "text",
                            "attr": "titleState",
                            "title": "Title state",
                            "width": "11%",
                            "default": ""
                        },
                        {
                            "type": "number",
                            "attr": "rtspPort",
                            "title": "RTSP port",
                            "width": "6%",
                            "min": 0,
                            "max": 65535,
                            "default": 0
                        }
                    ]
                },
                "autoDiscover": {
                    "type": "checkbox",
                    "label": "Without rows: one speaker for every satellite with a media player",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                }
            }
        },
        "_settingsTab": {
            "type": "panel",
            "label": "Settings",
            "items": {
                "assistantInstance": {
                    "type": "instance",
                    "adapter": "assistant",
                    "label": "Instance of ioBroker.assistant",
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "port": {
                    "type": "port",
                    "label": "HTTP port of the stream",
                    "min": 1,
                    "max": 65535,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "bind": {
                    "type": "ip",
                    "label": "Listen on",
                    "listenOnAllPorts": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "urlHost": {
                    "type": "text",
                    "label": "Address of this host for the player",
                    "help": "Empty: the address the sender reached",
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "syncVolume": {
                    "type": "checkbox",
                    "label": "Volume of the sender sets the player volume",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "holdMs": {
                    "type": "number",
                    "label": "Wait for a lost packet",
                    "unit": "ms",
                    "min": 50,
                    "max": 2000,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 3,
                    "lg": 3,
                    "xl": 3
                },
                "prerollMs": {
                    "type": "number",
                    "label": "Audio kept until the player connects",
                    "unit": "ms",
                    "min": 0,
                    "max": 5000,
                    "xs": 12,
                    "sm": 12,
                    "md": 3,
                    "lg": 3,
                    "xl": 3
                },
                "idleStop": {
                    "type": "number",
                    "label": "Stop the player after a pause of",
                    "help": "Silence keeps the stream open until then",
                    "unit": "s",
                    "min": 2,
                    "max": 3600,
                    "xs": 12,
                    "sm": 12,
                    "md": 3,
                    "lg": 3,
                    "xl": 3
                },
                "ffmpegPath": {
                    "type": "text",
                    "label": "Path of ffmpeg",
                    "help": "Empty: the bundled ffmpeg",
                    "xs": 12,
                    "sm": 12,
                    "md": 3,
                    "lg": 3,
                    "xl": 3
                }
            }
        }
    }
}
