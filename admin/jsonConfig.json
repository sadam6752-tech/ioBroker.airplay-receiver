{
    "i18n": true,
    "type": "tabs",
    "items": {
        "_speakersTab": {
            "type": "panel",
            "label": "Speakers",
            "items": {
                "_speakersHelp": {
                    "type": "staticText",
                    "text": "One row per AirPlay speaker. The name appears on the iPhone, the player is the media player of an ioBroker.assistant satellite that plays the music.",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "receivers": {
                    "type": "table",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "items": [
                        {
                            "type": "checkbox",
                            "attr": "enabled",
                            "title": "Active",
                            "width": "8%",
                            "default": true
                        },
                        {
                            "type": "text",
                            "attr": "name",
                            "title": "AirPlay name",
                            "width": "24%",
                            "default": ""
                        },
                        {
                            "type": "autocompleteSendTo",
                            "attr": "player",
                            "title": "Satellite player",
                            "width": "34%",
                            "command": "listPlayers",
                            "freeSolo": true,
                            "default": ""
                        },
                        {
                            "type": "select",
                            "attr": "format",
                            "title": "Format",
                            "width": "14%",
                            "default": "flac",
                            "noTranslation": true,
                            "options": [
                                {
                                    "label": "FLAC",
                                    "value": "flac"
                                },
                                {
                                    "label": "MP3",
                                    "value": "mp3"
                                }
                            ]
                        },
                        {
                            "type": "number",
                            "attr": "rtspPort",
                            "title": "RTSP port (0 = any)",
                            "width": "20%",
                            "min": 0,
                            "max": 65535,
                            "default": 0
                        }
                    ]
                },
                "autoDiscover": {
                    "type": "checkbox",
                    "label": "Without rows: one speaker for every satellite with a media player",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                }
            }
        },
        "_settingsTab": {
            "type": "panel",
            "label": "Settings",
            "items": {
                "assistantInstance": {
                    "type": "instance",
                    "adapter": "assistant",
                    "label": "Instance of ioBroker.assistant",
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "port": {
                    "type": "port",
                    "label": "HTTP port of the stream",
                    "min": 1,
                    "max": 65535,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "bind": {
                    "type": "ip",
                    "label": "Listen on",
                    "listenOnAllPorts": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "urlHost": {
                    "type": "text",
                    "label": "Address of this host for the satellite",
                    "help": "Empty: the address the sender reached",
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "sampleRate": {
                    "type": "select",
                    "label": "Sample rate of the stream",
                    "newLine": true,
                    "noTranslation": true,
                    "options": [
                        {
                            "label": "44100 Hz",
                            "value": 44100
                        },
                        {
                            "label": "48000 Hz",
                            "value": 48000
                        }
                    ],
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "channels": {
                    "type": "select",
                    "label": "Channels",
                    "options": [
                        {
                            "label": "Mono",
                            "value": 1
                        },
                        {
                            "label": "Stereo",
                            "value": 2
                        }
                    ],
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "syncVolume": {
                    "type": "checkbox",
                    "label": "Volume of the sender sets the satellite volume",
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "holdMs": {
                    "type": "number",
                    "label": "Wait for a lost packet",
                    "unit": "ms",
                    "min": 50,
                    "max": 2000,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 3,
                    "lg": 3,
                    "xl": 3
                },
                "prerollMs": {
                    "type": "number",
                    "label": "Audio kept until the satellite connects",
                    "unit": "ms",
                    "min": 0,
                    "max": 5000,
                    "xs": 12,
                    "sm": 12,
                    "md": 3,
                    "lg": 3,
                    "xl": 3
                },
                "idleStop": {
                    "type": "number",
                    "label": "Stop the satellite after a pause of",
                    "unit": "s",
                    "min": 2,
                    "max": 600,
                    "xs": 12,
                    "sm": 12,
                    "md": 3,
                    "lg": 3,
                    "xl": 3
                },
                "ffmpegPath": {
                    "type": "text",
                    "label": "Path of ffmpeg",
                    "help": "Empty: the bundled ffmpeg",
                    "xs": 12,
                    "sm": 12,
                    "md": 3,
                    "lg": 3,
                    "xl": 3
                }
            }
        }
    }
}
